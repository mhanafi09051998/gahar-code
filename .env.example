# Example environment for Gahar Code. Copy to .env or export in your shell.
# Never commit this file with real values; .env is git-ignored.

# OpenRouter API key (https://openrouter.ai/keys). Takes precedence over ~/.gahar/config.json.
OPENROUTER_API_KEY=

# Default model, e.g. anthropic/claude-sonnet-4.6
GAHAR_MODEL=
# API base URL (default https://openrouter.ai/api/v1)
GAHAR_BASE_URL=
# ask | auto-edit | full-auto
GAHAR_PERMISSION_MODE=
# Config directory instead of ~/.gahar
GAHAR_CONFIG_DIR=
# 1 disables the startup update check
GAHAR_NO_UPDATE_CHECK=
# 1 enables debug output
GAHAR_DEBUG=
# 1 emits JSONL events like --json
GAHAR_JSON=
# 1 disables colors
GAHAR_NO_COLOR=
# Windows only: powershell uses Windows PowerShell instead of pwsh
GAHAR_SHELL=
